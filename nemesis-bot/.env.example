# AI Bot Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ===== Telegram Bot Configuration =====
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ===== AI Provider Configuration =====
# Options: "gemini" (recommended), "ollama", "openrouter"
AI_PROVIDER=gemini

# ===== Gemini Configuration =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ===== Ollama Configuration =====
OLLAMA_API_KEY=
OLLAMA_MODEL=kimi-k2.5:cloud
OLLAMA_BASE_URL=http://localhost:11434

# ===== OpenRouter Configuration =====
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== Search API =====
# Brave Search는 웹 검색에 필요합니다
BRAVE_API_KEY=your_brave_search_api_key_here

# ===== Telegram Settings =====
TELEGRAM_TIMEOUT=30
TELEGRAM_POOL_TIMEOUT=30
# ⚠️ 보안 필수: 봇을 사용할 수 있는 사용자의 텔레그램 ID (여러 명일 경우 콤마로 구분)
# 비워두면 누구나 봇을 사용할 수 있습니다. system(명령 실행) 스킬이 있으므로
# 반드시 본인 ID를 설정하세요. 본인 ID는 @userinfobot 으로 확인할 수 있습니다.
# 예: ALLOWED_USER_ID=12345678,87654321
ALLOWED_USER_ID=

# ===== Brave Search Settings =====
BRAVE_SEARCH_COUNT=5

# ===== Ollama Port Isolation (Optional) =====
# 각각 다른 Ollama 인스턴스를 사용하려면 포트를 변경하세요.
# OLLAMA_BASE_URL=http://localhost:11435

# 허용목록(ALLOWED_USER_ID)이 비어 있을 때 봇을 전체 개방할지 여부.
# 기본 false(아무도 허용 안 함, 안전). 단독 테스트 등에서만 true로.
FAIL_OPEN_IF_NO_ALLOWLIST=false

# 원격 SSH 호스트 키 정책: reject(기본,미등록 거부) | warn | auto
NEMESIS_OPS_SSH_HOSTKEY_POLICY=reject
