# 관리 서버 포트
NEMESIS_API_PORT=18080
NEMESIS_CONTROL_PORT=17001
NEMESIS_UI_PORT=18090

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nemesis
DB_USER=nemesis
DB_PASSWORD=changeme

# AI Provider (openai / anthropic / ollama)
LLM_PROVIDER=openai
LLM_API_KEY=sk-placeholder
LLM_MODEL=gpt-4o

# 백엔드가 호출할 aibot 주소(host의 systemd 사이드카, host.docker.internal 경유 — 컨테이너 재생성/재부팅에도 안정적)
NEMESIS_AIBOT_URL=http://host.docker.internal:18900

# 알림 (Phase 2에서 활성화)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# 클러스터 설정
MAX_CLUSTER_GROUPS=10
