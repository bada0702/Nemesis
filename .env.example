# 관리 서버 포트
NEMESIS_API_PORT=18080
NEMESIS_CONTROL_PORT=17001
NEMESIS_UI_PORT=18090

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nemesis
DB_USER=nemesis
DB_PASSWORD=changeme

# AI Provider 기본값(부팅용). 실제 모델은 설치 후 UI '시스템 설정'에서 지정하면
# DB(system_settings)가 단일 출처로 이 값을 덮어쓰고 aibot까지 자동 전파됩니다.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=

# Ollama 위치. 컨테이너에서 호스트 Ollama 접근(host.docker.internal 는 compose extra_hosts 로 매핑됨)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI 사이드카(aibot) — 백엔드↔aibot 공유 토큰(양쪽 동일해야 함. setup.sh 가 자동 생성)
NEMESIS_AIBOT_TOKEN=changeme-aibot-token
# 백엔드가 호출할 aibot 주소(host의 systemd 사이드카, host.docker.internal 경유 — 컨테이너 재생성/재부팅에도 안정적)
NEMESIS_AIBOT_URL=http://host.docker.internal:18900
NEMESIS_AIOPS_ENABLED=true

# 외부 호스트 접속 시 UI origin 을 콤마로 추가
NEMESIS_ALLOWED_ORIGINS=http://localhost:18090

# 알림 (Phase 2에서 활성화)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# 클러스터 설정
MAX_CLUSTER_GROUPS=10
